const fs = require("fs");
const path = require("path");

const CONFIG_PATH = path.join(__dirname, "config.json");
const APPSTATE_PATH = path.join(__dirname, "appstate.json");

function fail(message) {
  console.log(`❌ ${message}`);
  process.exit(1);
}

if (!fs.existsSync(CONFIG_PATH)) {
  fail("config.json পাওয়া যায়নি।");
}

let config;

try {
  config = JSON.parse(fs.readFileSync(CONFIG_PATH, "utf8"));
} catch (err) {
  fail("config.json সঠিক JSON নয়।");
}

console.log("╔════════════════════════════════╗");
console.log("║       HRIDAY BOT LOGIN         ║");
console.log("╚════════════════════════════════╝");

if (!fs.existsSync(APPSTATE_PATH)) {
  console.log("");
  console.log("⚠️ appstate.json পাওয়া যায়নি।");
  console.log("ℹ️ কোনো password/cookie এই ফাইলে hard-code করা হয়নি।");
  console.log("");
  process.exit(0);
}

try {
  const data = JSON.parse(
    fs.readFileSync(APPSTATE_PATH, "utf8")
  );

  if (!Array.isArray(data)) {
    fail("appstate.json-এর format array হওয়া উচিত।");
  }

  console.log(`✅ Session file পাওয়া গেছে।`);
  console.log(`📦 Cookie entries: ${data.length}`);
  console.log(`🔐 AutoLogin: ${config.Session?.AutoLogin ? "ON" : "OFF"}`);
  console.log("");
  console.log("✅ Session validation সম্পন্ন।");
  console.log("⚠️ Facebook security/checkpoint bypass করা হচ্ছে না.");

} catch (err) {
  fail("appstate.json পড়া যাচ্ছে না বা JSON format ভুল।");
}
